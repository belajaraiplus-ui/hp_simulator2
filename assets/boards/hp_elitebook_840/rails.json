{
  "version": 1,
  "defaults": {
    "continuity": {
      "beep_below_ohms": 50.0,
      "open_above_ohms": 200.0
    }
  },
  "psu_injection": {
    "enabled": true,
    "path": ["direct", "diode", "fuse", "switch", "connector"],
    "series_resistance_ohm": 0.05,
    "max_voltage_v": 5.5,
    "max_current_a": 3.0,

    "backfeed": {
      "allowed": true,
      "targets": ["VSYS", "VIO"],
      "equiv_resistance_ohm": 1.2
    }
  },
  "rails": [
    {
      "id": "VBUS_5V",
      "label": "VBUS 5V",
      "type": "input",
      "expected": {
        "voltage_v": { "min": 4.75, "max": 5.25 },
        "diode_drop_v": { "min": 0.45, "max": 0.80 },
        "r2g_ohms": { "nominal": 500.0 }
      },
      "overlay": { "type": "multi_poly", "polys": [[[10,20],[60,20],[60,70],[10,70]]] },
      "probe_points": [{ "id": "TP_VBUS", "x": 35, "y": 45, "label": "TP_VBUS" }]
    },
    {
      "id": "VBAT",
      "label": "VBAT",
      "type": "power",
      "expected": {
        "voltage_v": { "min": 11.4, "max": 12.6 },
        "diode_drop_v": { "min": 0.45, "max": 0.80 },
        "r2g_ohms": { "nominal": 350.0 },
        "continuity": { "beep_below_ohms": 25.0, "open_above_ohms": 120.0 }
      },
      "depends_on": ["VBUS_5V"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[50,70],[110,70],[110,130],[50,130]]
        ]
      },
      "probe_points": [
        { "id": "TP_VBAT", "x": 80, "y": 100, "label": "TP_VBAT" }
      ]
    },
    {
      "id": "VSYS",
      "label": "VSYS",
      "type": "system",
      "expected": {
        "voltage_v": { "min": 11.4, "max": 12.6 },
        "diode_drop_v": { "min": 0.30, "max": 0.60 },
        "r2g_ohms": { "nominal": 200.0 }
      },
      "depends_on": ["VBAT"],
      "overlay": { "type": "multi_poly", "polys": [[[120,150],[170,150],[170,200],[120,200]]] },
      "probe_points": [{ "id": "TP_VSYS", "x": 145, "y": 175, "label": "TP_VSYS" }]
    },
    {
      "id": "VCORE",
      "label": "VCORE",
      "type": "core",
      "expected": {
        "voltage_v": { "min": 0.65, "max": 1.30 },
        "diode_drop_v": { "min": 0.25, "max": 0.55 },
        "r2g_ohms": { "nominal": 10.0 },
        "continuity": { "beep_below_ohms": 6.0, "open_above_ohms": 40.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[180,220],[250,220],[250,290],[180,290]]
        ]
      },
      "probe_points": [
        { "id": "TP_VCORE", "x": 215, "y": 255, "label": "TP_VCORE" }
      ]
    },
    {
      "id": "VCCFN",
      "label": "VCCFN (CPU Fabric)",
      "type": "core",
      "expected": {
        "voltage_v": { "min": 0.90, "max": 1.10 },
        "diode_drop_v": { "min": 0.25, "max": 0.55 },
        "r2g_ohms": { "nominal": 18.0 },
        "continuity": { "beep_below_ohms": 10.0, "open_above_ohms": 55.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[300,180],[360,180],[360,240],[300,240]]
        ]
      },
      "probe_points": [
        { "id": "TP_VCCFN", "x": 330, "y": 210, "label": "VCCFN" }
      ]
    },
    {
      "id": "VDD_3V3",
      "label": "VDD 3.3V",
      "type": "power",
      "expected": {
        "voltage_v": { "min": 3.2, "max": 3.4 },
        "diode_drop_v": { "min": 0.30, "max": 0.60 },
        "r2g_ohms": { "nominal": 300.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": { "type": "multi_poly", "polys": [[[380,100],[430,100],[430,150],[380,150]]] },
      "probe_points": [{ "id": "TP_VDD_3V3", "x": 405, "y": 125, "label": "TP_VDD_3V3" }]
    },
    {
      "id": "VIO",
      "label": "VIO",
      "type": "logic",
      "expected": {
        "voltage_v": { "min": 1.7, "max": 1.9 },
        "diode_drop_v": { "min": 0.20, "max": 0.45 },
        "r2g_ohms": { "nominal": 80.0 }
      },
      "depends_on": ["VDD_3V3"],
      "overlay": { "type": "multi_poly", "polys": [[[380,200],[430,200],[430,250],[380,250]]] },
      "probe_points": [{ "id": "TP_VIO", "x": 405, "y": 225, "label": "TP_VIO" }]
    }
  ]
}



