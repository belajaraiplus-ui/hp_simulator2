{
  "version": 1,
  "defaults": {
    "continuity": {
      "beep_below_ohms": 50.0,
      "open_above_ohms": 200.0
    }
  },
  "psu_injection": {
    "enabled": true,
    "path": ["direct", "diode", "fuse", "switch", "connector"],
    "series_resistance_ohm": 0.05,
    "max_voltage_v": 5.5,
    "max_current_a": 3.0,

    "backfeed": {
      "allowed": true,
      "targets": ["VSYS", "VIO"],
      "equiv_resistance_ohm": 1.2
    }
  },
  "rails": [
    {
      "id": "VBUS_5V",
      "label": "VBUS 5V",
      "type": "input",
      "expected": {
        "voltage_v": { "min": 4.75, "max": 5.25 },
        "diode_drop_v": { "min": 0.45, "max": 0.80 },
        "r2g_ohms": { "nominal": 450.0 },
        "continuity": { "beep_below_ohms": 30.0, "open_above_ohms": 150.0 }
      },
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[30,50],[80,50],[80,100],[30,100]]
        ]
      },
      "probe_points": [
        { "id": "TP_VBUS", "x": 55, "y": 75, "label": "VBUS" }
      ]
    },
    {
      "id": "VBAT",
      "label": "VBAT",
      "type": "power",
      "expected": {
        "voltage_v": { "min": 3.0, "max": 4.4 },
        "diode_drop_v": { "min": 0.35, "max": 0.65 },
        "r2g_ohms": { "nominal": 100.0 },
        "continuity": { "beep_below_ohms": 50.0, "open_above_ohms": 200.0 }
      },
      "depends_on": ["VBUS_5V"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[120,180],[170,180],[170,240],[120,240]]
        ]
      },
      "probe_points": [
        { "id": "TP_VBAT", "x": 145, "y": 210, "label": "TP_VBAT" }
      ]
    },
    {
      "id": "VSYS",
      "label": "VSYS",
      "type": "system",
      "expected": {
        "voltage_v": { "min": 3.5, "max": 4.2 },
        "diode_drop_v": { "min": 0.30, "max": 0.60 },
        "r2g_ohms": { "nominal": 200.0 }
      },
      "depends_on": ["VBAT"],
      "overlay": { "type": "multi_poly", "polys": [[[180,250],[240,250],[240,310],[180,310]]] },
      "probe_points": [{ "id": "TP_VSYS", "x": 210, "y": 280, "label": "TP_VSYS" }]
    },
    {
      "id": "VDD_3V3",
      "label": "VDD 3.3V",
      "type": "power",
      "expected": {
        "voltage_v": { "min": 3.2, "max": 3.4 },
        "diode_drop_v": { "min": 0.30, "max": 0.60 },
        "r2g_ohms": { "nominal": 300.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": { "type": "multi_poly", "polys": [[[260,250],[320,250],[320,310],[260,310]]] },
      "probe_points": [{ "id": "TP_VDD_3V3", "x": 290, "y": 280, "label": "TP_VDD_3V3" }]
    },
    {
      "id": "VCORE",
      "label": "VCORE",
      "type": "core",
      "expected": {
        "voltage_v": { "min": 0.70, "max": 1.20 },
        "diode_drop_v": { "min": 0.25, "max": 0.55 },
        "r2g_ohms": { "nominal": 15.0 },
        "continuity": { "beep_below_ohms": 10.0, "open_above_ohms": 60.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[200,80],[260,80],[260,140],[200,140]]
        ]
      },
      "probe_points": [
        { "id": "TP_VCORE", "x": 230, "y": 110, "label": "TP_VCORE" }
      ]
    },
    {
      "id": "VIO",
      "label": "VIO",
      "type": "logic",
      "expected": {
        "voltage_v": { "min": 1.7, "max": 1.9 },
        "diode_drop_v": { "min": 0.20, "max": 0.45 },
        "r2g_ohms": { "nominal": 80.0 }
      },
      "depends_on": ["VDD_3V3"],
      "overlay": { "type": "multi_poly", "polys": [[[340,200],[400,200],[400,260],[340,260]]] },
      "probe_points": [{ "id": "TP_VIO", "x": 370, "y": 230, "label": "TP_VIO" }]
    },
    {
      "id": "VDDR",
      "label": "VDDR",
      "type": "peripheral",
      "expected": {
        "voltage_v": { "min": 1.15, "max": 1.25 },
        "diode_drop_v": { "min": 0.20, "max": 0.50 },
        "r2g_ohms": { "nominal": 60.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": { "type": "multi_poly", "polys": [[[30,150],[90,150],[90,210],[30,210]]] },
      "probe_points": [{ "id": "TP_VDDR", "x": 60, "y": 180, "label": "TP_VDDR" }]
    }
  ]
}



