{
  "version": 1,
  "defaults": {
    "continuity": {
      "beep_below_ohms": 50.0,
      "open_above_ohms": 200.0
    }
  },
  "psu_injection": {
    "enabled": true,
    "path": ["direct", "diode", "fuse", "switch", "connector"],
    "series_resistance_ohm": 0.05,
    "max_voltage_v": 5.5,
    "max_current_a": 3.0,

    "backfeed": {
      "allowed": true,
      "targets": ["VSYS", "VIO"],
      "equiv_resistance_ohm": 1.2
    }
  },
  "rails": [
    {
      "id": "VBUS_5V",
      "label": "VBUS 5V",
      "type": "input",
      "expected": {
        "voltage_v": { "min": 4.75, "max": 5.25 },
        "diode_drop_v": { "min": 0.45, "max": 0.80 },
        "r2g_ohms": { "nominal": 500.0 }
      },
      "overlay": { "type": "multi_poly", "polys": [[[10,10],[50,10],[50,50],[10,50]]] },
      "probe_points": [{ "id": "TP_VBUS", "x": 30, "y": 30, "label": "TP_VBUS" }]
    },
    {
      "id": "VBAT",
      "label": "VBAT",
      "type": "power",
      "expected": {
        "voltage_v": { "min": 7.4, "max": 8.8 },
        "diode_drop_v": { "min": 0.35, "max": 0.65 },
        "r2g_ohms": { "nominal": 120.0 }
      },
      "depends_on": ["VBUS_5V"],
      "overlay": { "type": "multi_poly", "polys": [[[70,10],[110,10],[110,50],[70,50]]] },
      "probe_points": [{ "id": "TP_VBAT", "x": 90, "y": 30, "label": "TP_VBAT" }]
    },
    {
      "id": "VSYS",
      "label": "VSYS",
      "type": "system",
      "expected": {
        "voltage_v": { "min": 7.4, "max": 8.8 },
        "diode_drop_v": { "min": 0.30, "max": 0.60 },
        "r2g_ohms": { "nominal": 200.0 }
      },
      "depends_on": ["VBAT"],
      "overlay": { "type": "multi_poly", "polys": [[[130,10],[170,10],[170,50],[130,50]]] },
      "probe_points": [{ "id": "TP_VSYS", "x": 150, "y": 30, "label": "TP_VSYS" }]
    },
    {
      "id": "VDD_3V3",
      "label": "VDD 3.3V",
      "type": "power",
      "expected": {
        "voltage_v": { "min": 3.14, "max": 3.47 },
        "diode_drop_v": { "min": 0.35, "max": 0.65 },
        "r2g_ohms": { "nominal": 200.0 },
        "continuity": { "beep_below_ohms": 20.0, "open_above_ohms": 100.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[20,35],[60,35],[60,75],[20,75]]
        ]
      },
      "probe_points": [
        { "id": "TP_VDD_3V3", "x": 40, "y": 55, "label": "TP_VDD_3V3" }
      ]
    },
    {
      "id": "VIO",
      "label": "VIO (1.8V)",
      "type": "logic",
      "expected": {
        "voltage_v": { "min": 1.71, "max": 1.89 },
        "diode_drop_v": { "min": 0.30, "max": 0.50 },
        "r2g_ohms": { "nominal": 150.0 },
        "continuity": { "beep_below_ohms": 15.0, "open_above_ohms": 80.0 }
      },
      "depends_on": ["VDD_3V3"],
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[80,120],[120,120],[120,160],[80,160]]
        ]
      },
      "probe_points": [
        { "id": "TP_VIO", "x": 100, "y": 140, "label": "TP_VIO" }
      ]
    },
    {
      "id": "VCORE",
      "label": "VCORE",
      "type": "core",
      "expected": {
        "voltage_v": { "min": 0.80, "max": 1.10 },
        "diode_drop_v": { "min": 0.25, "max": 0.55 },
        "r2g_ohms": { "nominal": 20.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": { "type": "multi_poly", "polys": [[[140,120],[180,120],[180,160],[140,160]]] },
      "probe_points": [{ "id": "TP_VCORE", "x": 160, "y": 140, "label": "TP_VCORE" }]
    },
    {
      "id": "VDDR",
      "label": "VDDR",
      "type": "peripheral",
      "expected": {
        "voltage_v": { "min": 1.15, "max": 1.25 },
        "diode_drop_v": { "min": 0.20, "max": 0.50 },
        "r2g_ohms": { "nominal": 60.0 }
      },
      "depends_on": ["VSYS"],
      "overlay": { "type": "multi_poly", "polys": [[[200,120],[240,120],[240,160],[200,160]]] },
      "probe_points": [{ "id": "TP_VDDR", "x": 220, "y": 140, "label": "TP_VDDR" }]
    }
  ]
}



