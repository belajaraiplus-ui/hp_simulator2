        "voltage_v": { "min": 3.0, "max": 4.4 },
        "diode_drop_v": { "min": 0.35, "max": 0.65 },
        "r2g_ohms": { "nominal": 120.0 },
        "continuity": { "beep_below_ohms": 50.0, "open_above_ohms": 200.0 }
