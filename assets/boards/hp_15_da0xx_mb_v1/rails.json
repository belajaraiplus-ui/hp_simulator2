{
  "version": 1,
  "defaults": {
    "continuity": {
      "beep_below_ohms": 50.0,
      "open_above_ohms": 200.0
    }
  },
  "psu_injection": {
    "enabled": true,
    "path": ["direct", "diode", "fuse", "switch", "connector"],
    "series_resistance_ohm": 0.05,
    "max_voltage_v": 5.5,
    "max_current_a": 3.0,

    "backfeed": {
      "allowed": true,
      "targets": ["VSYS", "VIO"],
      "equiv_resistance_ohm": 1.2
    }
  },
  "rails": [
    {
      "id": "VBUS_5V",
      "label": "VBUS 5V",
      "type": "input",
      "expected": {
        "voltage_v": { "min": 4.75, "max": 5.25 },
        "diode_drop_v": { "min": 0.45, "max": 0.80 },
        "r2g_ohms": { "nominal": 500.0 },
        "continuity": { "beep_below_ohms": 30.0, "open_above_ohms": 150.0 }
      },
      "overlay": {
        "type": "multi_poly",
        "polys": [
          [[20,40],[70,40],[70,90],[20,90]]
        ]
      },
      "probe_points": [
        { "id": "TP_VBUS", "x": 45, "y": 65, "label": "TP_VBUS" }
      ]
    },

    {
      "id": "VBAT",
      "label": "VBAT",
      "type": "power",
